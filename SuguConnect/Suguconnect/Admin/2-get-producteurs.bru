meta {
  name: Get All Producteurs
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/producteurs
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
}

docs {
  # Récupérer Tous les Producteurs
  
  **Authentification:** Requiert un token ADMIN
  
  Retourne la liste complète de tous les producteurs inscrits, avec leur statut (EN_ATTENTE, ACCEPTE, REFUSE).
}
